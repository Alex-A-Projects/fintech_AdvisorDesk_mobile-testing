{
  "name": "fintech-advisordesk-mobile-testing",
  "version": "1.0.0",
  "description": "Mobile-web test framework for AdvisorDesk — driving Safari on iPhone 17 Pro Simulator (XCUITest) and Chrome on Samsung Galaxy S25 Emulator (UiAutomator2) via WebdriverIO + Appium 2.",
  "private": true,
  "type": "module",
  "scripts": {
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:android": "wdio run wdio.android.conf.ts",
    "test:both": "npm run test:android && npm run test:ios",
    "server": "http-server ./public -p 8765 -s",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "tsc --noEmit",
    "list:ios": "wdio run wdio.ios.conf.ts --spec ./tests/dashboard.spec.ts",
    "list:android": "wdio run wdio.android.conf.ts --spec ./tests/dashboard.spec.ts"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "typescript",
    "mobile-web",
    "ios",
    "android",
    "xcuitest",
    "uiautomator2",
    "safari",
    "chrome",
    "fintech",
    "advisordesk",
    "page-object-model",
    "mocha",
    "allure"
  ],
  "author": "QA Engineer",
  "license": "MIT",
  "dependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "allure-commandline": "^2.27.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^4.0.0",
    "appium-xcuitest-driver": "^7.0.0",
    "dotenv": "^16.4.5",
    "expect-webdriverio": "^6.0.9",
    "faker": "^5.5.3",
    "http-server": "^14.1.1",
    "webdriverio": "^9.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}