# ============================================
# AdvisorDesk Mobile-Web Test Framework - Environment
# ============================================

# Local URL where http-server serves ./public (see `npm run server`)
BASE_URL=http://localhost:8765/demo.html

# Appium server connection
APPIUM_HOST=localhost
APPIUM_PORT=4723

# iOS Simulator overrides (defaults shown)
IOS_DEVICE=iPhone 17 Pro
IOS_VERSION=26.0
# Set IOS_UDID when more than one simulator is booted, e.g.
# IOS_UDID=00000000-0000000000000000

# Android Emulator overrides (defaults shown)
ANDROID_DEVICE=Samsung Galaxy S25
ANDROID_OS=15
# Set ANDROID_UDID when more than one emulator is running, e.g.
# ANDROID_UDID=emulator-5554

# Test environment tag (used in Allure report titles)
TEST_ENV=staging

# Reporting
REPORT_TITLE=AdvisorDesk Mobile-Web Test Report